{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "colors": {
    "light": {
      "background": "#F7F6F3",
      "surface": "#FFFFFF",
      "text": "#1A1A1A",
      "text-2": "#8A8A8E",
      "hairline": "#E5E4E0",
      "work": "#3478F6",
      "sidegig": "#F5A623",
      "social": "#34C759",
      "shopping": "#AF52DE",
      "danger": "#FF3B30"
    },
    "dark": {
      "background": "#111113",
      "surface": "#1C1C1F",
      "text": "#F2F2F2",
      "text-2": "#98989E",
      "hairline": "#2C2C2E",
      "work": "#4C8DFF",
      "sidegig": "#FFB340",
      "social": "#40D66B",
      "shopping": "#BF5AF2",
      "danger": "#FF453A"
    },
    "scrim": {
      "light": "rgba(0, 0, 0, 0.4)",
      "dark": "rgba(0, 0, 0, 0.4)"
    }
  },
  "shadows": {
    "card": {
      "light": { "x": 0, "y": 1, "blur": 3, "spread": 0, "color": "#000000", "opacity": 0.05 },
      "dark": { "x": 0, "y": 1, "blur": 3, "spread": 0, "color": "#000000", "opacity": 0.4 }
    },
    "sheet": {
      "light": { "x": 0, "y": -8, "blur": 40, "spread": 0, "color": "#000000", "opacity": 0.18 },
      "dark": { "x": 0, "y": -8, "blur": 40, "spread": 0, "color": "#000000", "opacity": 0.5 }
    },
    "float": {
      "light": { "x": 0, "y": 4, "blur": 20, "spread": 0, "color": "#000000", "opacity": 0.12 },
      "dark": { "x": 0, "y": 4, "blur": 20, "spread": 0, "color": "#000000", "opacity": 0.45 }
    }
  },
  "radii": { "row": 12, "sheet": 20, "pill": 999 },
  "type": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", Inter, \"Segoe UI\", Roboto, sans-serif",
    "scale": {
      "screenTitle": { "size": 28, "weight": 700 },
      "rowTitle": { "size": 17, "weight": 600 },
      "notesPreview": { "size": 15, "weight": 400 },
      "dueChip": { "size": 13, "weight": 500 },
      "sectionHeader": { "size": 13, "weight": 500, "letterSpacing": 0.6 }
    }
  },
  "spacing": { "unit": 4, "screenGutter": 16 },
  "dimensions": { "rowMinHeight": 52, "touchTargetMin": 44 },
  "motion": {
    "durationsMs": { "sheet": 300, "rowPop": 200, "rowCollapse": 250, "contextCrossfade": 150 },
    "sheetCurve": [0.32, 0.72, 0, 1],
    "rowPopScale": [1, 1.15, 1],
    "scrimOpacity": 0.4,
    "reducedMotion": true
  }
}
