# ezyReminder — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Never commit `.env.local` or paste real keys into `.env.example`.

# ── Supabase ────────────────────────────────────────────────────────────
# 1. Create a project at https://supabase.com/dashboard (free tier is fine).
# 2. Project Settings → API → copy the "Project URL" and the "anon public" key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 3. Project Settings → API → copy the "service_role" key (server-only —
#    bypasses Row Level Security). Used by the pg_cron sweep / Edge Function
#    and server-side API-key hashing in Phase 2/6. NEVER expose to the client
#    or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 4. Auth → URL Configuration → add this app's origin (e.g.
#    http://localhost:3001 for local dev, your Vercel URL for prod) to
#    "Redirect URLs" so /auth/callback is allowed after a magic-link click.

# 5. Apply the schema: with the Supabase CLI linked to your project, run
#    `supabase db push` (or paste supabase/migrations/0001_init.sql into the
#    SQL editor once).

# ── Google Identity Services (native sign-in button, GOOGLE_NATIVE_SIGNIN_PROMPT.md) ──
# Same OAuth 2.0 Web Client already used for Supabase's Google provider —
# don't create a new one. Add this app's origin(s) to that client's
# "Authorized JavaScript origins" in Google Cloud Console (Credentials).
# Public value (safe to expose, same pattern as SLACK_CLIENT_ID below) — the
# GIS script reads it client-side to render the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ── Resend (email delivery, Phase 2) ───────────────────────────────────
# Create an API key at https://resend.com/api-keys and verify a sending
# domain (or use their shared onboarding domain for local testing).
# NOTE: the notification-sweep edge function runs on Supabase, not Vercel,
# so it can't read this file — also run:
#   npx supabase secrets set RESEND_API_KEY=... RESEND_FROM_EMAIL=...
# (SLACK_SIGNING_SECRET below is only read by the Next.js webhook route, not
# the edge function, so it does NOT need to be a Supabase secret.)
# See supabase/functions/notification-sweep/CRON_SETUP.md for the full setup.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=reminders@yourdomain.com

# ── Slack (DM delivery, Phase 2) ────────────────────────────────────────
# Create a Slack app at https://api.slack.com/apps (from scratch). Each user
# installs it into their own workspace via OAuth (Settings → Connect Slack),
# so there's no single static bot token — the app needs its own Client ID /
# Secret instead:
#   OAuth & Permissions → Redirect URLs: add
#     http://localhost:3001/api/integrations/slack/oauth/callback (dev)
#     https://your-app.vercel.app/api/integrations/slack/oauth/callback (prod)
#   OAuth & Permissions → Bot Token Scopes: chat:write, im:write
#   Interactivity & Shortcuts → Request URL:
#     https://your-app.vercel.app/api/integrations/slack/actions
#   Basic Information → App Credentials: Client ID / Client Secret / Signing Secret
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
# Verifies inbound requests to /api/integrations/slack/actions (Done/Snooze
# buttons) and is also set as a Supabase Function secret for the sweep.
SLACK_SIGNING_SECRET=your-signing-secret

# ── Twilio WhatsApp (Phase 5) ───────────────────────────────────────────
# Console → Account Info for the Account SID / Auth Token; WhatsApp senders
# require an approved sender + message template before sending.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Shippo (Phase 7) ─────────────────────────────────────────────────────
# Not needed until the Shippo integration lands — Phase 0-6 use manual
# carrier/tracking entry (lib/shipping/provider.ts ManualProvider).
SHIPPO_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────
# Base URL used to build absolute links in outbound emails/Slack messages
# and as the magic-link redirect origin fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3001
